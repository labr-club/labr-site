{
  "name": "labr-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "labr.club", "custom_domain": true },
    { "pattern": "www.labr.club", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
